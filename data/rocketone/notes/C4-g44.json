       [
        [
         "**M1 (Narrow Money)**",
         "Currency with Public + Demand Deposits + Other Deposits with RBI",
         "High liquidity; directly spendable transaction money."
        ],
        [
         "**M3 (Broad Money)**",
         "M1 + Time Deposits with Banks",
         "Most commonly used measure of broad aggregate money supply."
        ],
        [
         "**M1 vs M3 Difference**",
         "M3 minus M1 equals Time Deposits",
         "Time deposits are excluded from M1 and included in M3."
