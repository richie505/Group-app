      [
       "b",
       "**Zamindari rights:** under the Permanent Settlement they were hereditary + transferable / saleable.",
       "Indian History #110"
      ],
      [
       "b",
       "**Sunset Clause:** failure of the Zamindar to pay revenue by the prescribed sunset deadline → Zamindari auction.",
       "Indian History #110"
      ],
      [
       "b",
       "**Effect:** strengthened the landlord class; increased pressure on peasants.",
       "Indian History #110"
      ],
      [
