 "notes": [
  {
   "book": 5,
   "row": 38,
   "sec": 4,
   "append": true,
   "md": "- **GAGAN coverage:** serves the **Indian Flight Information Region** and supports precision approach and landing for civil aviation."
  },
  {
   "book": 5,
   "row": 39,
   "sec": 1,
   "append": true,
   "md": "- **EM spectrum order:** wavelength falls from radio → microwave → infrared → visible → ultraviolet → X-rays → **gamma rays**, so gamma rays have the shortest wavelength."
  },
  {
   "book": 5,
   "row": 39,
   "sec": 1,
   "append": true,
   "md": "- **Resolution meanings:** spatial = smallest object a sensor can see; spectral = number and width of bands; **temporal = how often the satellite revisits the same place**; radiometric = sensitivity to small differences in energy."
  },
  {
   "book": 5,
   "row": 40,
   "sec": 1,
   "append": true,
   "md": "- **Why docking matters:** SpaDeX docking technology is needed for the **Bharatiya Antariksh Station** and Chandrayaan-4."
  },
  {
   "book": 5,
   "row": 41,
   "sec": 9,
   "append": true,
   "md": "- **Columbia disaster:** Space Shuttle **Columbia** broke up on re-entry on **1 Feb 2003**, killing all seven crew, including **Kalpana Chawla**."
  }
 ],
