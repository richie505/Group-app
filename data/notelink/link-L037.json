 "notes": [
  {
   "book": 1,
   "row": 182,
   "sec": 3,
   "append": true,
   "md": "- **European troops drawn off:** On the eve of 1857 many European troops had been sent away to fight the **Crimean War** and the **Persian War**, so the sepoys greatly outnumbered them."
  },
  {
   "book": 1,
   "row": 182,
   "sec": 4,
   "append": true,
   "md": "- **Flour rumour:** A rumour said the Company's flour was mixed with **bone dust**."
  },
  {
   "book": 1,
   "row": 182,
   "sec": 4,
   "append": true,
   "md": "- **Chapatis:** Before the revolt, mysterious chapatis were passed from village to village across **North India**."
  },
  {
   "book": 1,
   "row": 182,
   "sec": 0,
   "append": true,
   "md": "- **Annexations and jobs:** Annexation of princely states (such as Awadh) threw thousands of officials, retainers and soldiers of the princely courts out of work."
  }
 ],
 "doubtful": []
