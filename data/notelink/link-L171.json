 "notes": [
  {
   "book": 5,
   "row": 60,
   "sec": 0,
   "append": true,
   "md": "- **Chemical energy:** energy stored in the **bonds of atoms and molecules** (food, fuels, dry cells); a stored (potential) form."
  },
  {
   "book": 5,
   "row": 60,
   "sec": 2,
   "append": true,
   "md": "- **Dam ownership:** about **98.5%** of India's operational specified dams are owned by the **States**; central PSUs, private bodies and the Centre own the rest."
  },
  {
   "book": 5,
   "row": 60,
   "sec": 5,
   "append": true,
   "md": "- **Hydro Purchase Obligation (HPO):** part of the March 2019 package; discoms must buy a set share of power from **large hydro projects (above 25 MW)**, separate from the non-solar RPO."
  },
  {
   "book": 5,
   "row": 61,
   "sec": 2,
   "append": true,
   "md": "- **Actinium series:** a natural decay series that begins with **U-235** and ends in **Pb-207**."
  }
 ],
