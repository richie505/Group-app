 "notes": [
  {
   "book": 1,
   "row": 86,
   "sec": 8,
   "append": true,
   "md": "- **Gram Sabha (Art. 243A):** Article 243A deals with the Gram Sabha, the body of all registered voters of a village Panchayat area."
  },
  {
   "book": 1,
   "row": 86,
   "sec": 8,
   "append": true,
   "md": "- **Intermediate tier (Art. 243B):** Under the 73rd Amendment, a State whose population does not exceed 20 lakh need not set up Panchayats at the intermediate level."
  },
  {
   "book": 1,
   "row": 87,
   "sec": 6,
   "append": true,
   "md": "- **Temple as meeting place:** Chola temples were also the venues where village assemblies held their meetings."
  },
  {
   "book": 1,
   "row": 87,
   "sec": 3,
   "append": true,
   "md": "- **DILRMP (modern land records):** The Digital India Land Records Modernisation Programme's first phase ran from 2008 to 2016; the 2016–2026 phase brought ULPIN (Bhu-Aadhaar), a unique ID for each land parcel."
  },
  {
   "book": 1,
   "row": 89,
   "sec": 0,
   "append": true,
   "md": "- **Khajuraho:** The Khajuraho temples of the Chandelas, such as Kandariya Mahadeva, are in the Nagara style."
  }
 ],
