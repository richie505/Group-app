 "notes": [
  {
   "book": 4,
   "row": 27,
   "sec": 4,
   "append": true,
   "md": "- **Dharali-Harsil (5 Aug 2025):** a **flash flood** hit Dharali-Harsil in Uttarkashi after an ice patch collapsed on the Srikanta glacier."
  },
  {
   "book": 4,
   "row": 27,
   "sec": 9,
   "append": true,
   "md": "- **NDMA avalanche guidelines:** cover both **structural** measures (snow nets, snow bridges, galleries) and **non-structural** measures (hazard zonation, early warning, training)."
  },
  {
   "book": 4,
   "row": 28,
   "sec": 7,
   "append": true,
   "md": "- **Types of mitigation:** **avoidance**, **minimization** and **compensatory** mitigation."
  },
  {
   "book": 4,
   "row": 28,
   "sec": 7,
   "append": true,
   "md": "- **Hazard-specific control activity:** a measure aimed at one particular hazard, e.g. building **flood levees** against floods."
  }
 ],
 "doubtful": []
}