 "notes": [
  {
   "book": 2,
   "row": 82,
   "sec": 6,
   "append": true,
   "md": "- Also in the Twelfth Schedule: **parks, gardens and playgrounds**; **promotion of cultural, educational and aesthetic aspects**."
  },
  {
   "book": 2,
   "row": 83,
   "sec": 5,
   "append": true,
   "md": "- **Gram Sabha competence (PESA s. 4(d), 4(e)):** safeguards traditions, customs, cultural identity, **community resources** and the **customary mode of dispute resolution**; **approves plans, programmes and projects** before the Panchayat takes them up."
  },
  {
   "book": 2,
   "row": 83,
   "sec": 6,
   "append": true,
   "md": "- **Niyamgiri (2013):** the Supreme Court asked the Gram Sabhas to decide whether the bauxite mining would affect their **religious and forest rights**."
  },
  {
   "book": 2,
   "row": 84,
   "sec": 0,
   "append": true,
   "md": "- **Thungon Committee (1988):** also recommended **constitutional recognition** of Panchayati Raj bodies."
  }
 ],
