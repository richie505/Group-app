 "notes": [
  {
   "book": 3,
   "row": 52,
   "sec": 7,
   "append": true,
   "md": "- **Tenant farmers' position (AP):** tenants pay rent and bear the production risk, but often have no land passbook, Kisan Credit Card (KCC) or crop insurance, so they miss formal credit and relief."
  },
  {
   "book": 3,
   "row": 52,
   "sec": 6,
   "append": true,
   "md": "- **AP crop insurance from Rabi 2024-25:** enrolment under PMFBY/RWBCIS became voluntary; the farmer pays a small fixed share of the premium and the State and the Centre share the rest equally."
  },
  {
   "book": 3,
   "row": 52,
   "sec": 7,
   "append": true,
   "md": "- **e-crop data gap:** insurance and relief in AP are given on the basis of e-crop booking, so actual cultivators (mostly tenants) missing from e-crop data can be left out of insurance and relief in a rainfall-deficit season."
  }
 ],
