 "notes": [
  {
   "book": 3,
   "row": 24,
   "sec": 3,
   "append": true,
   "md": "- **Real income from a price index:** Real national income = national income at current prices x 100 / price index (base year = 100). Example: Rs 30,000 crore x 100 / 150 = Rs 20,000 crore."
  },
  {
   "book": 3,
   "row": 27,
   "sec": 2,
   "append": true,
   "md": "- **Rate of natural increase:** CBR minus CDR (per 1,000 population). Example: CBR 30 - CDR 10 = 20 per 1,000 = 2.0% a year."
  }
 ],
