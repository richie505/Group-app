 "notes": [
  {
   "book": 5,
   "row": 73,
   "sec": 3,
   "append": true,
   "md": "- **Trophic level:** the functional position (feeding step) an organism occupies in a food chain – producer, herbivore, carnivore or top carnivore."
  },
  {
   "book": 5,
   "row": 73,
   "sec": 2,
   "append": true,
   "md": "- **Protists:** unicellular **eukaryotes** of water and moist places, some parasitic – not prokaryotes. Cyanobacteria are photosynthetic **prokaryotes** (many fix nitrogen); methanogens (archaea) live in anaerobic wetlands and the gut of ruminants."
  },
  {
   "book": 5,
   "row": 73,
   "sec": 9,
   "append": true,
   "md": "- **Wetland types:** coastal wetlands – lagoons, estuaries, mangroves, salt marshes; inland wetlands – lakes, ponds, marshes, floodplains."
  }
 ],
