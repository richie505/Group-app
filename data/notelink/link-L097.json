 "notes": [
  {
   "book": 3,
   "row": 1,
   "sec": 10,
   "append": true,
   "md": "- **Gold purity (carat):** pure gold is 24 carat, so 18 carat gold is 18/24 = 75% gold (22 carat = 91.6%)."
  },
  {
   "book": 3,
   "row": 1,
   "sec": 6,
   "append": true,
   "md": "- **Colonial deindustrialisation (Paul Bairoch):** India's share of world manufacturing output fell from about 24.5% (1750) to about 1.7% (1900)."
  },
  {
   "book": 3,
   "row": 0,
   "sec": 3,
   "append": true,
   "md": "- **Paradox of thrift (J.M. Keynes):** if everyone tries to save more at the same time, spending, income and output fall, so total saving may not rise."
  },
  {
   "book": 3,
   "row": 127,
   "sec": 0,
   "append": true,
   "md": "- **Villament:** a new urban housing type in AP cities that combines a villa and an apartment – villa-like space inside an apartment building with shared apartment amenities."
  }
 ],
