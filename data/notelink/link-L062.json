 "notes": [
  {
   "book": 2,
   "row": 22,
   "sec": 4,
   "append": true,
   "md": "- **Navtej Singh Johar (2018):** a **five-judge** Constitution Bench (CJI Dipak Misra) read down Sec. 377 IPC for consensual sex between adults."
  },
  {
   "book": 2,
   "row": 22,
   "sec": 4,
   "append": true,
   "md": "- **Supriyo (Oct 2023):** no fundamental right to marry; legal recognition of **same-sex marriage left to Parliament**."
  },
  {
   "book": 2,
   "row": 22,
   "sec": 7,
   "append": true,
   "md": "- **Union of India v. ADR (2002):** candidates must disclose their **criminal record, assets and educational qualifications**."
  },
  {
   "book": 2,
   "row": 22,
   "sec": 7,
   "append": true,
   "md": "- **Electoral Bonds case (Feb 2024):** a five-judge Bench unanimously struck down the scheme for violating the **voters' right to information** under Art. 19(1)(a)."
  },
  {
   "book": 2,
   "row": 22,
   "sec": 9,
   "append": true,
   "md": "- **Article 370 judgment (Dec 2023):** the Court held Article 370 was a **temporary provision** and upheld the President's power to declare it inoperative."
  },
  {
   "book": 2,
   "row": 22,
   "sec": 9,
   "append": true,
   "md": "- **Demonetisation case (Jan 2023):** the 2016 notification was upheld **4:1** as valid under **Section 26(2) of the RBI Act**."
  },
  {
   "book": 2,
   "row": 24,
   "sec": 1,
   "append": true,
   "md": "- **Munro's Madras Regulations (1816):** reversed the Cornwallis separation – the **Collector** again got **magisterial and police powers**, and village heads got petty police and judicial powers."
  }
 ],
