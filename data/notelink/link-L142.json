 "notes": [
  {
   "book": 4,
   "row": 44,
   "sec": 4,
   "append": true,
   "md": "- **Kondapalli chromite:** The chromite of the **Kondapalli Hills** in AP lies in the old **Krishna district** (now NTR district)."
  },
  {
   "book": 4,
   "row": 44,
   "sec": 8,
   "append": true,
   "md": "- **Critical Mineral Recycling Incentive Scheme:** a **Central Sector scheme** under NCMM (Cabinet, Sep 2025; Rs 1,500 crore); covers e-waste, lithium-ion battery scrap and other scrap."
  },
  {
   "book": 4,
   "row": 44,
   "sec": 8,
   "append": true,
   "md": "- **NCMM tools:** it encourages **PSUs and private firms to acquire critical mineral assets abroad** and plans a **National Critical Mineral Stockpile**."
  },
  {
   "book": 4,
   "row": 44,
   "sec": 6,
   "append": true,
   "md": "- **Nickname:** AP is called **'Ratna Garbha'** (womb of gems) for its rich and varied mineral deposits."
  }
 ],
