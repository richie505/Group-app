 "notes": [
  {
   "book": 1,
   "row": 38,
   "sec": 1,
   "append": true,
   "md": "- **Crafts:** good roads and state incentives encouraged crafts in the Mauryan period."
  },
  {
   "book": 1,
   "row": 39,
   "sec": 0,
   "append": true,
   "md": "- **Heavy taxation:** Kosambi also points to very heavy taxes, raised even on actors and prostitutes, as a sign of the money crisis of the later Mauryas."
  },
  {
   "book": 1,
   "row": 42,
   "sec": 4,
   "append": true,
   "md": "- **Other coins:** Kanishka's coins show the Buddha; Mahmud of Ghazni issued silver coins with Arabic and Sanskrit legends."
  }
