 "notes": [
  {
   "book": 2,
   "row": 164,
   "sec": 3,
   "append": true,
   "md": "- **UAPA, 1967:** India's main national-security law against **unlawful (disruptive) activities**, **unlawful associations** and **terror funding**."
  },
  {
   "book": 2,
   "row": 165,
   "sec": 5,
   "append": true,
   "md": "- **Poshan Maah and Poshan Pakhwada** are run under POSHAN Abhiyaan by the **Ministry of Women and Child Development**."
  },
  {
   "book": 2,
   "row": 165,
   "sec": 6,
   "append": true,
   "md": "- **Launch years:** **PMAY-Gramin – 2016** (from 1 April 2016, restructured from IAY); **PMAY-Urban – 2015**."
  },
  {
   "book": 2,
   "row": 166,
   "sec": 1,
   "append": true,
   "md": "- **TRYSEM** (Training of Rural Youth for Self-Employment) began on **15 August 1979**; later merged into SGSY (1999)."
  },
  {
   "book": 2,
   "row": 166,
   "sec": 5,
   "append": true,
   "md": "- **DAY-NULM** (2013) is run by the **Ministry of Housing and Urban Affairs** (earlier Housing and Urban Poverty Alleviation)."
  }
 ],
