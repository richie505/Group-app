 "notes": [
  {
   "book": 3,
   "row": 81,
   "sec": 5,
   "append": true,
   "md": "- **M1–M4 framework (1977):** RBI introduced the money supply measures M1, M2, M3 and M4 on the recommendation of the **Second Working Group on Money Supply** (1977)."
  },
  {
   "book": 3,
   "row": 82,
   "sec": 3,
   "append": true,
   "md": "- **Calibrated tightening:** a stance in which rate cuts are off the table; rate hikes are measured and need not come at every meeting."
  }
 ],
