 "notes": [
  {
   "book": 4,
   "row": 66,
   "sec": 6,
   "append": true,
   "md": "- **ANI and ASI:** the 2009 genetic study named the two ancestral groups of Indians **Ancestral North Indians (ANI)** and **Ancestral South Indians (ASI)**."
  },
  {
   "book": 4,
   "row": 66,
   "sec": 6,
   "append": true,
   "md": "- **Criticism of old schemes:** older racial schemes (Risley, Guha) relied on visible physical traits and colonial ethnography; modern genetics shows such rigid racial categories are not scientific."
  },
  {
   "book": 4,
   "row": 66,
   "sec": 3,
   "append": true,
   "md": "- **Western Brachycephals - regions:** Alpinoid and Dinaric types are found in Gujarat, Bengal, Odisha and Coorg; the Armenoid type in the Parsis."
  }
 ],
 "doubtful": []
