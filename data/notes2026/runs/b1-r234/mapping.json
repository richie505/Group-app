  ]
 },
 "g87d478e29d31": {
  "row": 235,
  "sub": 2,
  "lines": [
   "2:2"
  ],
  "add": "- **Mocherla Hanumantha Rao** organised Besant's tour of Kakinada, Rajahmundry and Eluru (1916)."
 },
 "n159b605ebd2": {
  "row": 235,
  "sub": 2,
  "lines": [],
  "add": "- After Besant's arrest (June 1917), protests at Tenali and Vijayawada were called **Confinement Day** protests."
 },
 "f39acdf14c38e": {
  "row": 235,
  "sub": 0,
  "lines": [
   "0:4.0"
  ],
  "add": "- The Vijayawada targets were to be met by **30 June 1921**."
 }
